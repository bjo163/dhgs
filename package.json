{
  "name": "dhgs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "22.23.x",
    "pnpm": "10.18.0"
  },
  "scripts": {
    "dev:public": "pnpm --filter @dhgs/public-web dev",
    "dev:ops": "pnpm --filter @dhgs/ops-web dev",
    "dev:api": "pnpm --filter @dhgs/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "toolchain:check": "node scripts/toolchain/check.mjs",
    "version:check": "node scripts/release/version-check.mjs",
    "release:plan": "node scripts/release/plan.mjs",
    "release:provenance": "node scripts/release/provenance.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
